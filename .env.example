# ============================================
# Research Advisor - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
#
# For Docker:  Override the paths/hosts marked with "Docker:" below.
#              Or just uncomment the Docker lines and comment the local ones.

# --- Required ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Backend ---
SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///./backend/data/app.db
# Docker: DATABASE_URL=sqlite:////app/backend/data/app.db

# --- Ports ---
API_PORT=8070
FRONTEND_PORT=5173
CALCULATOR_PORT=8000
STREAMLIT_PORT=8553


# --- LLM Settings ---
LLM_PROVIDER=anthropic  # "anthropic" or "openrouter"
MODEL_NAME=claude-sonnet-4-20250514
TEMPERATURE=0.1
MAX_TOKENS=4000

# --- OpenRouter (when LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemma-2-9b-it

# --- MCP Calculator Server ---
MCP_SERVER_URL=http://localhost:8000
CALCULATOR_TRANSPORT=stdio  # "stdio" (subprocess) or "sse" (HTTP)
# Docker: MCP_SERVER_URL=http://calculator:8000/sse
# Docker: CALCULATOR_TRANSPORT=sse

# --- LanceDB ---
# LANCEDB_PATH=backend/data/arxiv_lancedb
# Docker: LANCEDB_PATH=/app/backend/data/arxiv_lancedb

# --- MINIO (for attachments) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-to-a-random-secret-key
MINIO_SECURE=false
MINIO_BUCKET=attachments
STORAGE_BACKEND=local  # "local" or "minio"

# --- Optional ---
# OPENAI_API_KEY=your-openai-key-here
