# ============================================
# Research Advisor - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Required ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Backend ---
SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///./data/app.db

# --- MongoDB (for pipeline + calculator) ---
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=advisor_db

# --- LLM Settings ---
LLM_PROVIDER=anthropic  # "anthropic" or "openrouter"
MODEL_NAME=claude-sonnet-4-20250514
TEMPERATURE=0.1
MAX_TOKENS=4000

# --- OpenRouter (when LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemma-2-9b-it

# --- MCP Calculator Server ---
MCP_SERVER_URL=http://localhost:8000
CALCULATOR_TRANSPORT=stdio  # "stdio" (subprocess) or "sse" (HTTP)

# --- Optional ---
# OPENAI_API_KEY=your-openai-key-here
