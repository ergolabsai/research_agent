# ============================================
# Research Advisor - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Required ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Backend ---
SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///./data/app.db

# --- MongoDB (for pipeline + calculator) ---
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=advisor_db

# --- LLM Settings ---
MODEL_NAME=claude-sonnet-4-20250514
TEMPERATURE=0.1
MAX_TOKENS=4000

# --- MCP Calculator Server ---
MCP_SERVER_URL=http://localhost:8070

# --- MINIO (for attachments) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-to-a-random-secret-key
MINIO_SECURE=false
MINIO_BUCKET=attachments
STORAGE_BACKEND=local  # "local" or "minio"

# --- Optional ---
# OPENAI_API_KEY=your-openai-key-here
